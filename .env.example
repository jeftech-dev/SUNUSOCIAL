# SUNUSOCIAL — environment template.
# Copy to .env.local and fill in. Never commit real values (.env.local is git-ignored).
# Only NEXT_PUBLIC_* values reach the browser — keep everything else secret.

# --- Convex ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Auth ---
AUTH_SECRET=

# --- Payments (choose one provider: naboopay | sycapay — board decision pending) ---
PAYMENT_PROVIDER=naboopay
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
SYCAPAY_API_KEY=
SYCAPAY_WEBHOOK_SECRET=

# --- SMS (2FA + blood alerts; provider pending) ---
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# --- WhatsApp contact link (E.164) ---
WHATSAPP_CONTACT_NUMBER=+221770000000

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MODERATION_URL=http://localhost:3000/moderation
