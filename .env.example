# SUNUSOCIAL — environment template.
# Copy to .env.local and fill in. Never commit real values (.env.local is git-ignored).
# Only NEXT_PUBLIC_* values reach the browser — keep everything else secret.
# Server-side values are set in the Convex environment (npx convex env set NAME value).

# --- Convex ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Auth (Convex Auth — JWT_PRIVATE_KEY / JWKS are set in Convex, not here) ---
SITE_URL=http://localhost:3000

# --- Payments: naboopay | mock (mock is refused in production) ---
PAYMENT_PROVIDER=mock
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- One-time codes & SMS (SMS pending board approval) ---
OTP_CHANNEL=email
SMS_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# --- Product rules awaiting board answers (interim defaults, see docs/DECISIONS.md §3) ---
BLOOD_ALERTS_HOSPITAL_SELF_SERVE=false
ENFORCE_PROOF_DEADLINE_ON_RELEASE=false
MAX_CAUSE_DURATION_DAYS=90
MIN_DONATION=500
PLATFORM_FEE_RATE=0
REFUND_FEE_POLICY=refund_net

# --- WhatsApp contact link (E.164) ---
WHATSAPP_CONTACT_NUMBER=+221770000000

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MODERATION_URL=http://moderation.localhost:3000
