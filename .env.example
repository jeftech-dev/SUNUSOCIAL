# SUNUSOCIAL — environment template.
# Copy to .env.local and fill in. Never commit real values (.env.local is git-ignored).
# Only NEXT_PUBLIC_* values reach the browser — keep everything else secret.
# Server-side values are set in the Convex environment (npx convex env set NAME value).

# --- Runtime: development | preview | production ---
# Set in Convex too (npx convex env set APP_ENV production) for the production deployment:
# production refuses PAYMENT_PROVIDER=mock and SMS_PROVIDER=console, and disables seed:run.
APP_ENV=development

# --- Convex ---
NEXT_PUBLIC_CONVEX_URL=
# HTTP actions origin (signup receipt upload). Derived from NEXT_PUBLIC_CONVEX_URL for cloud
# deployments (.convex.cloud → .convex.site); set it for a local backend (http://127.0.0.1:3211)
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# --- Auth (Convex Auth — JWT_PRIVATE_KEY / JWKS are set in Convex, not here) ---
SITE_URL=http://localhost:3000
# Base URL of the moderation app, used in moderator password links (set in Convex too)
MODERATION_SITE_URL=http://moderation.localhost:3000
SESSION_TOTAL_DAYS=7

# --- Payments: naboopay | mock (mock is refused in production) ---
# With `mock`, checkout sends the donor to the in-app simulator (/paiement/simulation/<id>); no
# NabooPay keys are needed. Set these for `naboopay`, in Convex (npx convex env set NAME value).
PAYMENT_PROVIDER=mock
# NabooPay API keys, least privilege (DT-4): checkout scope for transactions, payout scope (Sprint 6)
NABOOPAY_CHECKOUT_KEY=
NABOOPAY_PAYOUT_KEY=
# Secret of the webhook registered at https://<deployment>.convex.site/payments/naboopay/webhook
# (NabooPay dashboard → Settings → Integration → Webhooks, version v2). Used to verify X-Signature.
# With `mock` and no secret set, the simulator signs webhooks with a built-in dev key.
NABOOPAY_WEBHOOK_SECRET=

# --- SMS: console (dev/preview, prints codes to logs) | <provider> (production) ---
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
# Codes per 24 h to signed-out people, all numbers together (interim cost guard, DT-2)
SMS_DAILY_CAP=1000
# Key for the SMS code hashes — set in Convex, required in production:
#   npx convex env set OTP_HASH_SECRET "$(openssl rand -hex 32)"
OTP_HASH_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Product rules (docs/DECISIONS.md §3) ---
MAX_CAUSE_DURATION_DAYS=30
MAX_EXTENSION_DAYS=30
PROOF_DUE_DAYS=7
MIN_DONATION=500
PLATFORM_FEE_RATE=0
REQUIRE_PHASE2_BEFORE_PAYOUT=false

# --- WhatsApp contact link (E.164) ---
# SUNUSOCIAL's official number, still to be provided by the board (BOARD_QUESTIONS.md part E).
# The "Nous contacter sur WhatsApp" buttons are hidden while it is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MODERATION_URL=http://moderation.localhost:3000
